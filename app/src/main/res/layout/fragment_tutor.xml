<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="智能辅导" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" /><TextView android:id="@+id/text_tutor_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="把不会的内容交给学习导师一起拆解" android:textColor="@color/text_secondary" android:textSize="14sp" />
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" app:cardCornerRadius="12dp" app:strokeColor="@color/surface_variant"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="推荐提问" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" /><Button android:id="@+id/button_tutor_question_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="start|center_vertical" android:text="帮我梳理一个知识点" android:textAllCaps="false" /><Button android:id="@+id/button_tutor_question_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:text="根据我的路径安排复习" android:textAllCaps="false" /><Button android:id="@+id/button_tutor_new" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="新建辅导会话" android:textAllCaps="false" /></LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:id="@+id/text_tutor_history_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="最近会话" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" /><LinearLayout android:id="@+id/tutor_history_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" /></LinearLayout></ScrollView>
