<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><EditText android:id="@+id/input_resource_search" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="搜索课程资料" android:inputType="text" android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="12dp" /><Button android:id="@+id/button_resource_search" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="搜索" android:textAllCaps="false" /></LinearLayout>
<Button android:id="@+id/button_resource_advanced_search" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="6dp" android:text="高级搜索" android:textAllCaps="false" />
<TextView android:id="@+id/text_resource_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="正在加载资源..." android:textColor="@color/text_secondary" android:textSize="14sp" />
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"><LinearLayout android:id="@+id/resource_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
<Button android:id="@+id/button_resource_retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="重新加载" android:textAllCaps="false" android:visibility="gone" />
</LinearLayout>
