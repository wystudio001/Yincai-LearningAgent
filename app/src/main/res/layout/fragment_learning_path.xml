<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/text_path_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在加载学习路径..." android:textColor="@color/text_secondary" android:textSize="14sp" />
<TextView android:id="@+id/text_path_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="我的学习路径" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
<LinearLayout android:id="@+id/path_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
<Button android:id="@+id/button_path_retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:text="重新加载" android:textAllCaps="false" android:visibility="gone" />
</LinearLayout></ScrollView>
