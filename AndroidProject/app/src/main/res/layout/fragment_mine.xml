<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="22dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:background="@drawable/bg_line_row" android:padding="16dp">
            <TextView android:id="@+id/text_mine_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="学生" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="学生账号 · 因材智学" android:textColor="@color/text_secondary" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="学习与资料" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:background="@drawable/bg_line_row">
            <Button android:id="@+id/button_mine_profile" style="@style/Widget.YinCai.LineRow" android:drawableEnd="@drawable/ic_line_chevron_right" android:text="学习画像"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/surface_variant"/>
            <Button android:id="@+id/button_mine_profile_dialogue" style="@style/Widget.YinCai.LineRow" android:drawableEnd="@drawable/ic_line_chevron_right" android:text="对话构建画像"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/surface_variant"/>
            <Button android:id="@+id/button_mine_assessment" style="@style/Widget.YinCai.LineRow" android:drawableEnd="@drawable/ic_line_chevron_right" android:text="评估报告"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/surface_variant"/>
            <Button android:id="@+id/button_mine_wrong_questions" style="@style/Widget.YinCai.LineRow" android:drawableEnd="@drawable/ic_line_chevron_right" android:text="错题本"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="账户与系统" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:background="@drawable/bg_line_row">
            <Button android:id="@+id/button_mine_notifications" style="@style/Widget.YinCai.LineRow" android:drawableEnd="@drawable/ic_line_chevron_right" android:text="通知中心"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/surface_variant"/>
            <Button android:id="@+id/button_mine_settings" style="@style/Widget.YinCai.LineRow" android:drawableEnd="@drawable/ic_line_chevron_right" android:text="设置"/>
        </LinearLayout>
        <Button android:id="@+id/button_logout" style="@style/Widget.YinCai.LineDanger" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="24dp" android:text="退出登录"/>
    </LinearLayout>
</ScrollView>
